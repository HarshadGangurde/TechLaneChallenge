# --- Google Sheets (server-side only; never prefix with NEXT_PUBLIC_) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON. "\n" escapes are handled.
GOOGLE_PRIVATE_KEY=
# Preferred alternative: the whole service-account JSON, base64-encoded
# (base64 -w0 service-account.json). If set, it overrides the two vars above.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Staff CSV export ---
# Long random secret (>= 24 chars): openssl rand -base64 32
ADMIN_EXPORT_TOKEN=

# --- Optional ---
# Public site URL used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where students can send correction/deletion requests (shown on the form). e.g. an email address
NEXT_PUBLIC_PRIVACY_CONTACT=
